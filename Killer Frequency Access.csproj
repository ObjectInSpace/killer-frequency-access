<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RootNamespace>Killer_Frequency_Access</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameDir>D:\SteamLibrary\steamapps\Common\Killer Frequency</GameDir>
    <MelonLoaderDir>$(GameDir)\MelonLoader</MelonLoaderDir>
    <Il2CppAssembliesDir>$(MelonLoaderDir)\Il2CppAssemblies</Il2CppAssembliesDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <EmbeddedResource Remove="decompiled\**" />
    <None Remove="decompiled\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Walking graphs from the rip's NavMesh assets (tools\rip\gen_navmesh.py). -->
    <EmbeddedResource Include="Generated\Nav\*.navbin.gz" LogicalName="Nav.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
